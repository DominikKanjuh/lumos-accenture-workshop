{"ts": "2026-11-25T17:24:22.745896+00:00", "tool": "Bash", "input": {"command": ".venv/bin/python - <<'EOF'\nimport re,pathlib\np=pathlib.Path(\"tools/drift-check/rules.json\"); s=p.read_text()\nold1='''        \"service.month_period\"\n      ],\n      \"tests\": [],'''\nnew1='''        \"service.month_period\"\n      ],\n      \"tests\": [\n        \"test_models.py::test_billing_period_days_includes_start_and_end\"\n      ],'''\nold2='''        \"billing.create_invoice\"\n      ],\n      \"tests\": [],\n      \"examples\": [\n        {\n          \"table\": 0,'''\nassert s.count(old1)==1\ni=s.index('\"Billing-Rules#full-example\"'); j=s.index(old2,i)\ns=s.replace(old1,new1)\ni=s.index('\"Billing-Rules#full-example\"'); j=s.index(old2,i)\ns=s[:j]+old2.replace('\"tests\": [],','\"tests\": [\\n        \"test_billing.py::test_create_invoice_matches_wiki_full_example\"\\n      ],')+s[j+len(old2):]\np.write_text(s)\nimport json; json.loads(s)\nEOF\ngit diff --stat tools/drift-check/rules.json; sed -n 1,20p CHANGELOG.md; grep -n \"Status\" issues/BUG-158-*.md issues/BUG-142-*.md", "description": "Update rules.json, inspect changelog/status"}}
