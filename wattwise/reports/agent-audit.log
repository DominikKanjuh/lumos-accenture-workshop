{"ts": "2026-11-25T17:23:57.124568+00:00", "tool": "Bash", "input": {"command": "cat >> tests/test_models.py <<'EOF'\n\n\n# Regression test for BUG-158\n# Wiki Billing-Rules#billing-period: both start and end are billable, days = end - start + 1\n# 2026-11-01..2026-11-30: 29 + 1 = 30 \u00b7 2026-12-01..2026-12-31: 30 + 1 = 31 \u00b7\n# 2027-02-01..2027-02-28: 27 + 1 = 28\n@pytest.mark.parametrize(\n    \"start,end,expected\",\n    [\n        (date(2026, 11, 1), date(2026, 11, 30), 30),\n        (date(2026, 12, 1), date(2026, 12, 31), 31),\n        (date(2027, 2, 1), date(2027, 2, 28), 28),\n    ],\n)\ndef test_billing_period_days_includes_start_and_end(\n    start: date, end: date, expected: int\n) -> None:\n    assert BillingPeriod(start, end).days == expected\nEOF\ncat >> tests/test_billing.py <<'EOF'\n\n\n# Regression test for BUG-158\n# Wiki Billing-Rules#full-example, WattWise Basic, November 2026, 247 kWh:\n# base fee 9.90 * 12 / 365 * 30 = 9.7643... -> 9.76 (30 days, not 29)\n# energy 247 * 0.3450 = 85.215 -> 85.22 \u00b7 net 9.76 + 85.22 = 94.98\n# VAT 94.98 * 0.19 = 18.0462 -> 18.05 \u00b7 total 94.98 + 18.05 = 113.03\ndef test_create_invoice_matches_wiki_full_example(customer, meter, november) -> None:\n    invoice = create_invoice(\n        customer,\n        get_tariff(\"BASIC\"),\n        meter,\n        november,\n        reading(41210, NOV_1),\n        reading(41457, DEC_1),\n    )\n    assert [(line.description, line.amount) for line in invoice.lines] == [\n        (\"Base fee (30 days)\", Decimal(\"9.76\")),\n        (\"Energy (247 kWh)\", Decimal(\"85.22\")),\n    ]\n    assert invoice.net == Decimal(\"94.98\")\n    assert invoice.vat == Decimal(\"18.05\")\n    assert invoice.gross == Decimal(\"113.03\")\nEOF\nsed -i '' 's/^from datetime import date$/from datetime import date\\nfrom decimal import Decimal/' tests/test_billing.py\nhead -3 tests/test_billing.py\n.venv/bin/python -m pytest -q tests/test_models.py tests/test_billing.py 2>&1 | grep -E \
